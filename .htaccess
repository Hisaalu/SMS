<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # Automatically set the rewrite base depending on whether /NexaT/ is part of the request path
    RewriteCond %{REQUEST_URI} ^/NexaT/
    RewriteRule ^ - [E=BASE_DIR:/NexaT/]
    RewriteCond %{REQUEST_URI} !^/NexaT/
    RewriteRule ^ - [E=BASE_DIR/]

    # If the request is not for a valid file or directory
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^(.*)$ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "DENY"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

Options -Indexes